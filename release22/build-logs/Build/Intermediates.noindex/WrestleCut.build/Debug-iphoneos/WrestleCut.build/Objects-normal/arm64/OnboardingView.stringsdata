        }
      },
      {
        "comment": "",
        "key": "DATES",
        "location": {
          "startingColumn": 22,
          "startingLine": 101
        }
      },
      {
        "comment": "",
        "key": "Cut starts",
        "location": {
          "startingColumn": 28,
          "startingLine": 102
        }
      },
      {
        "comment": "",
        "key": "Weigh-in day",
        "location": {
          "startingColumn": 28,
          "startingLine": 104
        }
      },
      {
        "comment": "",
        "key": "Safe pace. This protects muscle, strength, and focus.",
        "location": {
          "startingColumn": 32,
          "startingLine": 114
        }
      },
      {
        "comment": "",
        "key": "Above the 1.5–2% safe guideline. Wrestle Cut will warn you and suggest a longer timeline or higher class. We don't build crash cuts.",
        "location": {
          "startingColumn": 25,
          "startingLine": 115
        }
      },
      {
        "comment": "",
        "key": "Tap everything you strongly dislike or are allergic to. Wrestle Cut will avoid it in every meal plan. Allergies: always double-check labels yourself.",
        "location": {
          "startingColumn": 18,
          "startingLine": 120
        }
      },
      {
        "comment": "",
        "key": "Used only to show nearby stores that carry your meal-plan products — Walmart, Kroger, Publix, Whole Foods, Aldi, Target, Costco. Nothing is sent to a server in offline mode.",
        "location": {
          "startingColumn": 18,
          "startingLine": 138
        }
      },
      {
        "comment": "",
        "key": "You can skip this and add it later.",
        "location": {
          "startingColumn": 18,
          "startingLine": 140
        }
      },
      {
        "comment": "",
        "key": "How your calories are calculated: Mifflin-St Jeor BMR × activity, minus a modest deficit (400–550 cal). Protein is set at 2.2 g per kg of goal weight to protect muscle. Every number in WrestleCut shows its formula — no black box.",
        "location": {
          "startingColumn": 18,
          "startingLine": 151
        }
      },
