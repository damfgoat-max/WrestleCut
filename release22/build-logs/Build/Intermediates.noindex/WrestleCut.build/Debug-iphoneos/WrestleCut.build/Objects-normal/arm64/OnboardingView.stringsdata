      {
        "comment": "",
        "key": "WRESTLE CUT",
        "location": {
          "startingColumn": 18,
          "startingLine": 34
        }
      },
      {
        "comment": "",
        "key": "Cut Weight Safely • Made for Wrestlers",
        "location": {
          "startingColumn": 18,
          "startingLine": 37
        }
      },
      {
        "comment": "",
        "key": "Guidance only — not medical advice. Talk to your coach, athletic trainer, or doctor before cutting weight, especially if you are under 18.",
        "location": {
          "startingColumn": 18,
          "startingLine": 49
        }
      },
      {
        "comment": "",
        "key": "Back",
        "location": {
          "startingColumn": 34,
          "startingLine": 48
        }
      },
      {
        "comment": "",
        "key": "Make the weight.\nStay strong.\nDominate.",
        "location": {
          "startingColumn": 18,
          "startingLine": 55
        }
      },
      {
        "comment": "",
        "key": "WrestleCut builds a safe, progressive plan — never a crash cut. Fat loss early, smart water timing late, and a full rehydration plan after you step off the scale.",
        "location": {
          "startingColumn": 18,
          "startingLine": 59
        }
      },
      {
        "comment": "",
        "key": "No ads. No subscriptions. 100% free, forever.",
        "location": {
          "startingColumn": 19,
          "startingLine": 61
        }
      },
      {
        "comment": "",
        "key": "Safety first: max 1.5–2% body weight per week",
        "location": {
          "startingColumn": 19,
          "startingLine": 62
        }
      },
      {
        "comment": "",
        "key": "Works fully offline. Your data stays on your phone.",
        "location": {
          "startingColumn": 19,
          "startingLine": 63
        }
      },
      {
        "comment": "",
        "key": "%lld'%lld\" = %lld cm — both are kept in sync for the formulas.",
        "location": {
          "startingColumn": 18,
          "startingLine": 87
        }
      },
      {
        "comment": "",
        "key": "BIOLOGICAL SEX — FOR CALORIE MATH",
        "location": {
          "startingColumn": 22,
          "startingLine": 70
        }
      },
      {
        "comment": "",
        "key": "TRAINING LEVEL",
        "location": {
          "startingColumn": 22,
          "startingLine": 77
        }
      },
      {
        "comment": "",
        "key": "Total to lose",
        "location": {
          "startingColumn": 22,
          "startingLine": 96
        }
      },
      {
        "comment": "",
        "key": "%@ lb",
        "location": {
          "startingColumn": 22,
